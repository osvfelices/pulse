// Object literals
const a = {}
const b = { x: 1 }
const c = { x: 1, y: 2 }
const d = { x: 1, y: 2, }  // trailing comma
const e = { x }  // shorthand
const f = { ...other }
const g = { x: 1, ...middle, z: 3 }
const h = { [key]: value }  // computed
const i = { 'Content-Type': 'text/html' }  // string key
