# Pulse NPM Package - Exclude non-essential files
# Only include core language: lib/, package.json, README.md, LICENSE, CHANGELOG.md

# Documentation (users can view on GitHub/website)
docs/
*.md
!README.md
!CHANGELOG.md

# Development & tooling
tools/
scripts/
.github/
.vscode/
assets/
examples/
pre_release_audit/

# Tests
tests/
baselines/

# Test files in lib/
lib/test-*.js
lib/*/test-*.js
lib/*/*/test-*.js
lib/*/*.test.js
lib/*/*/*.test.js
lib/*/run-tests.sh
lib/*/run-type-tests.sh

# Semantic test files
lib/semantic/test-*.js

# AST test files
lib/ast/test-*.js
lib/ast/run-tests.sh

# IR test files
lib/ir/test-*.js
lib/ir/run-tests.sh

# Runtime test files
lib/runtime/test-*.js
lib/runtime/run-type-tests.sh

# Build artifacts
*.log
*.tgz
dist/
build/
.pulse-build/

# Git
.git/
.gitignore
.gitattributes
*.yml

# IDE
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Misc
TODO.md
NOTES.md
*.backup

# Development runtime files (not for distribution)
lib/runtime/*-2.0.0-dev.js
lib/runtime/resources/admission/*-2.0.0-dev.js
